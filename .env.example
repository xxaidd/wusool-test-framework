# Backend base URLs used by the Wusool Testing Framework.
# These are baked into the client at build time (NEXT_PUBLIC_), so restart
# the dev server after editing. Non-secret values; keep secrets out of .env*.
NEXT_PUBLIC_WUSOOL_LOCAL_URL=http://localhost:5002
NEXT_PUBLIC_WUSOOL_DEV_URL=https://api-dev.wusool.to/
NEXT_PUBLIC_WUSOOL_STAGING_URL=https://api-dev.wusool.to/
